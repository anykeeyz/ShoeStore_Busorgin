<Page x:Class="ShoeStore_Бусоргин.Views.AddEditOrderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ShoeStore_Бусоргин.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddEditOrderPage">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Код получения:" VerticalAlignment="Center"/>
        <TextBox x:Name="txtCode" Grid.Column="1" Grid.Row="0" Margin="0,5" PreviewTextInput="NumberValidation"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Статус заказа:" VerticalAlignment="Center"/>
        <ComboBox x:Name="cmbStatus" Grid.Row="1" Grid.Column="1" Margin="0,5" DisplayMemberPath="OrderStatus"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Адрес пункта выдачи:" VerticalAlignment="Center"/>
        <ComboBox x:Name="cmbAddress" Grid.Row="2" Grid.Column="1" Margin="0,5" DisplayMemberPath="Address"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Клиент:" VerticalAlignment="Center"/>
        <ComboBox x:Name="cmbClient" Grid.Row="3" Grid.Column="1" Margin="0,5" DisplayMemberPath="FullName"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Дата заказа:" VerticalAlignment="Center"/>
        <DatePicker x:Name="dpOrderDate" Grid.Row="4" Grid.Column="1" Margin="0,5"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="Дата выдачи:" VerticalAlignment="Center"/>
        <DatePicker x:Name="dpDeliveryDate" Grid.Row="5" Grid.Column="1" Margin="0,5"/>

        <TextBlock Grid.Row="6" Grid.Column="0" Text="Товары в заказе:" VerticalAlignment="Top" Margin="0,5"/>

        <StackPanel Grid.Row="6" Grid.Column="1" Margin="0,5">
            <Grid Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="cmbProduct" Grid.Column="0" Margin="0,0,5,0" DisplayMemberPath="DisplayText"/>
                <TextBox x:Name="txtQuantity" Grid.Column="1" Width="60" Margin="0,0,5,0" Text="1" PreviewTextInput="NumberValidation"/>
                <Button x:Name="btnAddProduct" Content="Добавить" Width="80" Grid.Column="2" Click="btnAddProduct_Click"/>
            </Grid>

            <DataGrid x:Name="dgOrderProducts" Height="200" AutoGenerateColumns="False" 
                      IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Товар" Binding="{Binding ProductName}" Width="*"/>
                    <DataGridTextColumn Header="Количество" Binding="{Binding Count}" Width="80"/>
                    <DataGridTextColumn Header="Цена" Binding="{Binding Price, StringFormat={}{0:F2}}" Width="80"/>
                    <DataGridTextColumn Header="Сумма" Binding="{Binding Total, StringFormat={}{0:F2}}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>

            <Button x:Name="btnRemoveProduct" Content="Удалить выбранный товар" Width="150" HorizontalAlignment="Right" Margin="0,5,0,0" Click="btnRemoveProduct_Click"/>

            <TextBlock x:Name="txtTotalSum" Text="Общая сумма: 0.00 руб." FontWeight="Bold" Margin="0,5,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="8" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="btnSave" Content="Сохранить" Width="100" Height="30" Margin="0,0,10,0" Click="btnSave_Click"/>
            <Button x:Name="btnCancel" Content="Отмена" Width="100" Height="30" Click="btnCancel_Click"/>
        </StackPanel>
    </Grid>
</Page>
