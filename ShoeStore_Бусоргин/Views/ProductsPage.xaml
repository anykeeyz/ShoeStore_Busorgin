<Page x:Class="ShoeStore_Бусоргин.Views.ProductsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:local="clr-namespace:ShoeStore_Бусоргин.Views"
    mc:Ignorable="d" 
    d:DesignHeight="450" d:DesignWidth="800"
    Title="ProductsPage" IsVisibleChanged="Page_IsVisibleChanged">


    <Page.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <local:UsernameConverter x:Key="UsernameConverter"/>
        <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Page.Resources>

<Grid>
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#7FFF00" Padding="20 10">
            <Grid>
                <TextBlock Text="{Binding fullName, Converter={StaticResource UsernameConverter}}"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Image Source="/Res/Icon.png" Height="60"/>
                    <TextBlock Text="Каталог обуви" 
                         FontSize="24" 
                         FontWeight="Bold"
                         VerticalAlignment="Center"
                         Margin="20,0,0,0"/>
                </StackPanel>
                
                <Button Name="LogoutBtn" Content="Выйти" FontSize="14" FontWeight="SemiBold"
                    VerticalAlignment="Top"
                    Margin="0 0 0 2"
                    HorizontalAlignment="Right"
                    Padding="5 2" Click="ExitBtn_Click"
                    />

                <Button Name="ToOrderBtn" Content="К заказам" FontSize="14" FontWeight="SemiBold"
                    VerticalAlignment="Bottom"
                    Margin="0 2 0 0"
                    HorizontalAlignment="Right"
                    Padding="5 2" Click="ToOrderBtn_Click"
    />
            </Grid>
    </Border>

        <Border x:Name="MenuBorder" Grid.Row="1" Background="#7FFF00" Padding="10" Margin="0 10 0 0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Поиск"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"/>

                <TextBox x:Name="SearchTxt" MinWidth="100" TextChanged="TextBox_TextChanged" FontSize="14" />

                <GroupBox Header="Сортировка по кол-ву на складе" FontSize="14" FontWeight="SemiBold" Padding="5">
                    <StackPanel Orientation="Horizontal">
                        <Button Name="UpBtn" Content="По возрастанию" Click="UpBtn_Click"/>
                        <Button Name="DownBtn" Content="По убыванию" Margin="5 0 0 0" Click="DownBtn_Click"/>
                    </StackPanel>
                </GroupBox>

                <TextBlock Text="Поставщик" Margin="10 0"/>
                <ComboBox Name="SuppCmb" Height="25" MinWidth="100" FontSize="14"
                    SelectionChanged="SuppCmb_SelectionChanged">
                </ComboBox>

                <Button Content="Сбросить" Click="RefreshBtn_Click" VerticalAlignment="Center" Margin="10 0"/>
                <Button Name="AddTovarBtn" Content="Добавить товар" Click="AddTovar_Click" VerticalAlignment="Center" Margin="5 0"/>
            </StackPanel>
        </Border>

        <ListView x:Name="ProductsListView" 
        Grid.Row="2"
        Margin="10"
        BorderThickness="0"
        VirtualizingPanel.ScrollUnit="Pixel"
        VirtualizingStackPanel.VirtualizationMode="Recycling" MouseDoubleClick="EditProductClick">
            <ListView.ContextMenu>
                <ContextMenu Name="ShoesContextMenu">
                    <MenuItem Header="Удалить" Click="Delete_Click"/>
                </ContextMenu>
            </ListView.ContextMenu>
        
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#7FFF00" 
                BorderThickness="2" 
                Padding="5"
                HorizontalAlignment="Stretch"
                CornerRadius="5">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Padding" Value="5"/>
                                <Setter Property="Margin" Value="0,5,0,5"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHighDiscount}" Value="True">
                                        <Setter Property="Background" Value="#2E8B57"/>
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding IsOutOfStock}" Value="True">
                                        <Setter Property="Background" Value="Cyan" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" 
                        BorderBrush="#00FA9A" 
                        BorderThickness="1"
                        Margin="5">
                                <Image Name="ProductImg"
                            Stretch="Uniform"
                            Height="120"
                            Width="120"
                            Source="{Binding PhotoPath, FallbackValue=Res/picture.jpg}">
                                </Image>
                            </Border>

                            <StackPanel Grid.Column="1" 
                            Margin="10,5">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <TextBlock Text="{Binding Category}" 
                                    FontWeight="Bold"
                                    Foreground="#2E8B57"/>
                                    <TextBlock Text=" - " 
                                    FontWeight="Bold"/>
                                    <TextBlock Text="{Binding ProdName}" 
                                    FontWeight="Bold"
                                    FontSize="14"/>
                                </StackPanel>

                                <TextBlock Text="{Binding Description}" 
                                TextWrapping="Wrap"
                                Margin="0,3"
                                Foreground="#333333"/>

                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <TextBlock Text="Производитель: " FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Producer}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <TextBlock Text="Поставщик: " FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Supplier}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <TextBlock Text="{Binding Price, StringFormat={}{0:C}}"
                                    FontWeight="Bold"
                                    FontSize="16"
                                    Margin="0,0,10,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOnSale}" Value="True">
                                                        <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                        <Setter Property="Foreground" Value="Red"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock Visibility="{Binding IsOnSale, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Run Text="Цена со скидкой: " Foreground="Black"/>
                            <Run Text="{Binding DiscountedPrice, Mode=OneWay, StringFormat={}{0:C}}" 
                                    Foreground="Black"
                                    FontWeight="Bold"
                                    FontSize="16"/>
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <TextBlock Text="На складе: " FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding OnStock}"/>
                                    <TextBlock Text=" " />
                                    <TextBlock Text="{Binding Unit}"/>
                                </StackPanel>
                            </StackPanel>

                            <Border Grid.Column="2" 
                        Background="#00FA9A"
                        CornerRadius="10"
                        Margin="5"
                        VerticalAlignment="Top"
                        Height="140"
                        Width="120">
                                <StackPanel HorizontalAlignment="Center" 
                                VerticalAlignment="Center">
                                    <TextBlock Text="Скидка" 
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontWeight="Bold"
                                    FontSize="12"/>
                                    <TextBlock Text="{Binding Discount, StringFormat={}{0}%}"
                                    HorizontalAlignment="Center"
                                    FontSize="24"
                                    FontWeight="Bold"
                                    Foreground="#2E8B57"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
