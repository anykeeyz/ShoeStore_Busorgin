<Page x:Class="ShoeStore_Бусоргин.Views.AddEditTovarPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ShoeStore_Бусоргин.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddEditTovarPage">
    <Page.Resources>
        <Style TargetType="TextBlock">
            <Style.Setters>
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="20 0"/>
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="FontWeight" Value="DemiBold"/>
            </Style.Setters>
        </Style>
        <Style TargetType="TextBox">
        <Style.Setters>
            <Setter Property="Width" Value="300"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="Margin" Value="0 3"/>
                <Setter Property="MaxWidth" Value="400"/>
                <Setter Property="MaxHeight" Value="30"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            </Style.Setters>
        </Style>
        <Style TargetType="ComboBox">
            <Style.Setters>
            <Setter Property="Width" Value="300"/>
                <Setter Property="Margin" Value="0 3"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="MaxWidth" Value="400"/>
                <Setter Property="MaxHeight" Value="30"/>
            </Style.Setters>
        </Style>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition MinHeight="50"/>
            <RowDefinition MinHeight="40"/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#7FFF00" Padding="20 10">
            <Grid>
                <TextBlock Text="Управление товаром" 
                     FontSize="24" 
                     FontWeight="Bold"
                     VerticalAlignment="Center"
                     HorizontalAlignment="Center"
                     Margin="20,0,0,0"/>
                <Button Content="Выйти" FontSize="14" FontWeight="SemiBold"
                VerticalAlignment="Center"
                HorizontalAlignment="Right"
                Padding="10 5" Click="ExitBtn_Click"/>
            </Grid>
        </Border>

        <TextBlock Grid.Row="1" Text="Фото товара"/>
        <Grid Grid.Row="1" Grid.Column="1">
            
            <Image Name="ShoesImg" Source="{Binding _product.PhotoPath, FallbackValue=picture.jpg}"  HorizontalAlignment="Left" Stretch="Uniform" Width="50"/>
            
            <Button  Margin="60 0 0 20" HorizontalAlignment="Left" VerticalAlignment="Center" Width="150"
                Content="Выбрать изображение" Click="ChooseImg_Click"/>
            <TextBlock Name="PhotoPathTxt" HorizontalAlignment="Left" Text="Не выбрано" Margin="60 20 0 0" VerticalAlignment="Center"
                FontSize="14"/>
        </Grid>

        <TextBlock Grid.Row="2" Text="Название товара"/>
        <TextBox Name="ProdNameTxt" Grid.Row="2" Grid.Column="1" Text="{Binding _product.ProdName}"/>

        <TextBlock Grid.Row="3" Text="Категория товара"/>
        <ComboBox Name="CatComboBox" Grid.Row="3" Grid.Column="1"
            ItemsSource="{Binding _categories}"
            SelectedValuePath="Id"
            DisplayMemberPath="Category"/>

        <TextBlock Grid.Row="4" Text="Описание товара"/>
        <TextBox Name="DescriptionTxt" Grid.Row="4" Grid.Column="1" Text="{Binding _product.Description}"/>

        <TextBlock Grid.Row="5" Text="Производитель"/>
        <ComboBox Name="ProdComboBox" Grid.Row="5" Grid.Column="1"
            ItemsSource="{Binding _producers}"
            SelectedValuePath="Id"
            DisplayMemberPath="Producer"/>

        <TextBlock Grid.Row="6" Text="Поставщик"/>
        <ComboBox Name="SuppComboBox" Grid.Row="6" Grid.Column="1"
            ItemsSource="{Binding _suppliers}"
            SelectedValuePath="Id"
            DisplayMemberPath="Supplier"/>

        <TextBlock Grid.Row="7" Text="Цена"/>
        <TextBox Name="PriceTxt" Grid.Row="7" Grid.Column="1" Text="{Binding _product.Price}" PreviewTextInput="PriceTxt_Validation"/>

        <TextBlock Grid.Row="8" Text="Ед. измерения"/>
        <TextBox Name="UnitTxt" Grid.Row="8" Grid.Column="1" Text="{Binding _product.Unit}"/>

        <TextBlock Grid.Row="9" Text="Количество на складе"/>
        <TextBox Name="OnStockTxt" Grid.Row="9" Grid.Column="1" Text="{Binding _product.OnStock}" PreviewTextInput="OnStockTxt_PreviewTextInput"/>

        <TextBlock Grid.Row="10" Text="Скидка"/>
        <TextBox Name="DiscountTxt" Grid.Row="10" Grid.Column="1" Text="{Binding _product.Discount}" PreviewTextInput="DiscountTxt_PreviewTextInput"/>

        <Button Grid.Row="11" Grid.ColumnSpan="2" Margin="200 3" Content="Сохранить" MaxHeight="30" MaxWidth="500" Click="btnSave_Click"/>
        <Button Grid.Row="12" Grid.ColumnSpan="2" Margin="200 3" Content="Отмена"  MaxHeight="30" MaxWidth="500" Click="Cancel_Click"/>
    </Grid>
</Page>
