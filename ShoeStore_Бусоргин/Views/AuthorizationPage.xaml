<Page x:Class="ShoeStore_Бусоргин.Views.AuthorizationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ShoeStore_Бусоргин.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AuthorizationPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.4*"/>
            <RowDefinition  Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#7FFF00" Margin="40 20"
        CornerRadius="15">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
            Orientation="Horizontal">
                <Image Source="/Res/Icon.JPG" Margin="20 20"/>
                <TextBlock Text="Авторизация" VerticalAlignment="Center" FontSize="20"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" HorizontalAlignment="Center">
            <TextBlock Text="Логин" MinHeight="20" MinWidth="300" Margin=" 0 20 0 10"/>
            <TextBox x:Name="LoginTxt"  MinHeight="20"/>

            <TextBlock Text="Пароль"  Margin=" 0 20 0 10"/>
            <PasswordBox x:Name="PaswordTxt"/>

            <Button Content="Войти"  Margin=" 0 20 0 10" Click="LoginBtn_Click"/>
            <Button Content="Войти как гость" Click="GuestEnter"/>
        </StackPanel>
        
    </Grid>
</Page>
