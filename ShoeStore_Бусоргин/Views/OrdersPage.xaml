<Page x:Class="ShoeStore_Бусоргин.Views.OrdersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ShoeStore_Бусоргин.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="OrdersPage">

    <Page.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <Style TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="Height" Value="20"/>
        <Setter Property="Margin" Value="10"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#7FFF00" Padding="20 10">
            <Grid>
                <TextBlock Text="{Binding fullName}"
                    TextWrapping="Wrap"
                    HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Image Source="/Res/Icon.png" Height="60"/>
                    <TextBlock Text="Список заказов" 
                         FontSize="24" 
                         FontWeight="Bold"
                         VerticalAlignment="Center"
                         Margin="20,0,0,0"/>
                </StackPanel>

                <Button Content="Выйти" FontSize="14" FontWeight="SemiBold"
                    VerticalAlignment="Top"
                    Margin="0 0 0 2"
                    HorizontalAlignment="Right"
                    Padding="5 2" Click="ExitBtn_Click"
                    />

                <Button Content="К товарам" FontSize="14" FontWeight="SemiBold"
                    VerticalAlignment="Bottom"
                    Margin="0 2 0 0"
                    HorizontalAlignment="Right"
                    Padding="5 2" Click="ToProducts_Click"
                    />
            </Grid>
        </Border>

        <Border x:Name="MenuBorder" Grid.Row="1" Background="#7FFF00" Padding="10" Margin="0 10 0 0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="btnAddOrder" Content="Добавить заказ" Width="100" Height="20" Margin="0,0,10,0" Click="btnAddOrder_Click"/>
                <Button x:Name="btnEditOrder" Content="Редактировать" Width="100" Height="20" Margin="0,0,10,0" Click="btnEditOrder_Click"/>
                <Button x:Name="btnDeleteOrder" Content="Удалить" Width="100" Height="20" Click="btnDeleteOrder_Click"/>
            </StackPanel>
        </Border>

        <ListView x:Name="OrdersListView" 
        Grid.Row="2"
        Margin="10"
        BorderThickness="0"
        VirtualizingPanel.ScrollUnit="Pixel"
        VirtualizingStackPanel.VirtualizationMode="Recycling" MouseDoubleClick="OrdersListView_MouseDoubleClick">
            <ListView.ContextMenu>
                <ContextMenu Name="ShoesContextMenu">
                    <MenuItem Header="Удалить" Click="btnDeleteOrder_Click"/>
                </ContextMenu>
            </ListView.ContextMenu>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#7FFF00" 
                BorderThickness="2" 
                Padding="5"
                HorizontalAlignment="Stretch"
                CornerRadius="5">
                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" 
                            Margin="10,5">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <TextBlock Text="Номер заказа: " 
                                        FontWeight="Bold"
                                        FontSize="14"/>
                                    <TextBlock Text="{Binding  Id}" 
                                    FontWeight="Bold"
                                    FontSize="14"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <TextBlock Text="Статус заказа: " FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding OrderStatuses.OrderStatus}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <TextBlock Text="Адрес пункта выдачи: " FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Addresses.Address}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <TextBlock Text="Дата заказа: " FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding OrderDate, StringFormat='d MMMM yyyy'}"/>
                                </StackPanel>
                            </StackPanel>

                            <Border Grid.Column="1" 
                        Background="#00FA9A"
                        CornerRadius="10"
                        Margin="5"
                        VerticalAlignment="Top"
                        Height="140"
                        Width="120">
                                <StackPanel HorizontalAlignment="Center" 
                                VerticalAlignment="Center">
                                    <TextBlock Text="Дата доставки" 
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontWeight="Bold"
                                    FontSize="12"/>
                                    <TextBlock Text="{Binding Deliverydate, StringFormat='d MMMM yyyy'}"
                                    HorizontalAlignment="Center"
                                    FontSize="18"
                                    FontWeight="Bold"
                                    Foreground="#2E8B57"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
